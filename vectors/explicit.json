          "message": "This model's maximum context length is 131072 tokens. However, your messages resulted in 140000 tokens. Please reduce the length of the messages.",
          "type": "invalid_request_error",
          "param": "messages",
          "code": "context_length_exceeded"
        }
      },
      "expect": {
        "input_tokens": 140000,
        "limit": 131072
      }
    },
